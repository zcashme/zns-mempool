# Put the RPC credentials in the URL. URL-encode reserved password characters.
NODE_RPC_URL=http://rpc-user:rpc-password@127.0.0.1:8232
DATABASE_URL=postgresql://scanner:password@db.example.com:5432/postgres?sslmode=require

# Optional — defaults to http://127.0.0.1:8230
NODE_INDEXER_GRPC_URL=http://127.0.0.1:8230